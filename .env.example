# Run node scripts/setup.mjs to create .env with generated local credentials.
BOOKSTACK_PUBLIC_URL=http://localhost:6875
BOOKSTACK_URL=http://bookstack:80
BOOKSTACK_APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=
BOOKSTACK_ADMIN_PASSWORD=
INBOUND_EMAIL_TOKEN=
ADMIN_TOKEN=
ASSET_PREFIXES=ASSET,LAPTOP,DESKTOP,PC,SRV,SERVER,PRINTER,MONITOR,SW
# Optional trusted help-desk participants allowed to append email replies.
SUPPORT_EMAILS=
# Host-only npm start default; Compose sets /data/assetdesk.sqlite itself.
DATABASE_PATH=./data/assetdesk.sqlite
PORT=3000
