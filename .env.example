# Run node scripts/setup.mjs to generate private local credentials.
INBOUND_EMAIL_TOKEN=
ADMIN_TOKEN=
# Separate browser login; the setup script generates its initial password.
DASHBOARD_ADMIN_EMAIL=admin@assetdesk.local
DASHBOARD_ADMIN_PASSWORD=
# Set true when serving the dashboard through HTTPS in production.
COOKIE_SECURE=false
# Use 1 only behind the documented trusted host reverse proxy.
TRUST_PROXY_HOPS=0
ASSET_PREFIXES=ASSET,LAPTOP,DESKTOP,PC,SRV,SERVER,PRINTER,MONITOR,SW
# Optional trusted help-desk participants allowed to append email replies.
SUPPORT_EMAILS=
# Host-only npm start default; Compose sets /data/assetdesk.sqlite itself.
DATABASE_PATH=./data/assetdesk.sqlite
PORT=3000
