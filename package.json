{
  "name": "assetdesk",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Self-contained IT service desk, knowledge base, and personnel and equipment inventory",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/*browser.spec.mjs",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mailparser": "^3.9.12",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
